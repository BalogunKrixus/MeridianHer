{
  "name": "@meridianher/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./patterns/*": "./src/patterns/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./gallery": "./src/gallery/design-gallery.tsx",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "recharts": "3.8.0",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@meridianher/config": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
