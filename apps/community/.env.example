# Copy to .env.local. Values come from the Supabase dashboard, Project settings, API keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# This app's address, used for sign in redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production only: share the session between community and admin subdomains
AUTH_COOKIE_DOMAIN=
# Server only, never NEXT_PUBLIC. Used to delete under 16 accounts during onboarding
SUPABASE_SECRET_KEY=sb_secret_xxx
